# Pflichtfelder: Werte privat im Sparked-Host-Dateimanager eintragen.
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_OWNER_IDS=
ALPACA_PAPER_KEY=
ALPACA_PAPER_SECRET=

# Beispiel-Watchlist zum Testen, keine Kaufempfehlungen. Maximal 20 Symbole.
WATCHLIST=AAPL,MSFT,NVDA,AMZN,META,GOOGL,AMD,TSLA,SPY,QQQ
ALLOW_SHORTS=true

# Prozentangaben: 1 bedeutet 1 %, nicht 0.01.
RISK_PER_TRADE_PCT=1
STOP_LOSS_PCT=1
TAKE_PROFIT_R=2
DAILY_LOSS_LIMIT_PCT=3
MAX_POSITION_PCT=20
MAX_GROSS_EXPOSURE_PCT=60
MAX_POSITIONS=3
MAX_TRADES_PER_DAY=3

# Neue Einstiege als Limitorder nahe dem aktuellen IEX-Kurs.
ENTRY_SLIPPAGE_PCT=0.10
MAX_SPREAD_PCT=0.25
MAX_SIGNAL_DRIFT_PCT=0.50
ENTRY_TIMEOUT_SECONDS=120
QUOTE_MAX_AGE_SECONDS=120

SCAN_INTERVAL_SECONDS=60
POLL_INTERVAL_SECONDS=15
STATUS_INTERVAL_MINUTES=30
CLOSED_STATUS_INTERVAL_MINUTES=180
ENTRY_CUTOFF_MINUTES=30
CLOSE_BEFORE_MINUTES=10
DATA_DIR=data

# Beim allerersten Start pausiert der Handel. Aktivieren mit /start.
# Danach bleiben /start und /pause auch nach Neustarts gespeichert.
# Es gibt absichtlich keine konfigurierbare Live-Trading-URL.
