# Only these two secrets are required. Never publish a completed .env.
DISCORD_TOKEN=
ALPACA_KEY=
# ALPACA_KEY format: PAPER_KEY_ID:PAPER_SECRET_KEY

# Optional settings, shown at the shipped defaults:
RISK_PER_TRADE_PCT=0.25
PORTFOLIO_RISK_PCT=0.75
DAILY_LOSS_LIMIT_PCT=3
MAX_POSITION_PCT=20
MAX_GROSS_EXPOSURE_PCT=60
MAX_POSITIONS=3
MAX_TRADES_PER_DAY=3
SCANNER_SHORTLIST_SIZE=80
MIN_FEED_DOLLAR_VOLUME=1000000
MIN_RVOL=1.5
QUOTE_MAX_AGE_SECONDS=10
MAX_SPREAD_PCT=0.10
COST_BUFFER_PCT=0.05
ALLOW_SHORTS=true
# Railway only, after mounting a persistent volume at /data:
# DATA_DIR=/data
